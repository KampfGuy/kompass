# ---- Blocks shared by Kugel Blocks and Kugel Blocks 3D: sound, events, control, common sensing, operators,
# variables and lists. Format: [op, category, shape, text, defaults, KampfScript template, flags] — see spec2d.ks.
let COMMON_ROWS = [
  ["playsound", "sound", "stack", "start sound %d.sound", ["pop"], "kb_sound(me, $1, false)", ""],
  ["playwait", "sound", "stack", "play sound %d.sound until done", ["coin"], "kb_sound(me, $1, true)", ""],
  ["note", "sound", "stack", "play note %n for %n beats", [60, 0.5], "kb_note(me, $1, $2)", ""],
  ["volume", "sound", "stack", "set volume to %n %", [100], "kb_set_volume($1)", ""],
  ["getvolume", "sound", "num", "volume", [], "KB.volume", ""],
  ["flag", "events", "hat", "when ⚑ clicked", [], "@flag", ""],
