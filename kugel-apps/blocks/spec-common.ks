  ["broadcastwait", "events", "stack", "broadcast %d.msg and wait", ["@msg"], "kb_broadcast_wait(me, $1)", ""],
  ["wait", "control", "stack", "wait %n seconds", [1], "kb_wait(me, $1)", ""],
  ["repeat", "control", "c", "repeat %n", [10], "for _ in kb_int($1) {\n$SUB\n  kb_yield(me)\n}", ""],
  ["forever", "control", "ccap", "forever", [], "while true {\n$SUB\n  kb_yield(me)\n}", ""],
  ["if", "control", "c", "if %b then", [], "if $1 {\n$SUB\n}", ""],
  ["ifelse", "control", "c2", "if %b then", [], "if $1 {\n$SUB\n} else {\n$SUB2\n}", ""],
  ["waituntil", "control", "stack", "wait until %b", [], "while not ($1) { kb_yield(me) }", ""],
  ["repeatuntil", "control", "c", "repeat until %b", [], "while not ($1) {\n$SUB\n  kb_yield(me)\n}", ""],
