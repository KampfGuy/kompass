  ["resettimer", "sensing", "stack", "reset timer", [], "kb_reset_timer()", ""],
  ["days", "sensing", "num", "days since 2000", [], "kb_days()", ""],
  ["add", "operators", "num", "%n + %n", ["", ""], "($1 + $2)", ""],
  ["sub", "operators", "num", "%n - %n", ["", ""], "($1 - $2)", ""],
  ["mul", "operators", "num", "%n * %n", ["", ""], "($1 * $2)", ""],
  ["div", "operators", "num", "%n / %n", ["", ""], "kb_div($1, $2)", ""],
  ["rand", "operators", "num", "pick random %n to %n", [1, 10], "kb_random($1, $2)", ""],
